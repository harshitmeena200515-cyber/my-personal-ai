# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Model Router Settings
DEFAULT_LOCAL_MODEL=qwen2.5-coder:3b
DEFAULT_CLOUD_MODEL=gemini-2.0-flash
ROUTER_MODE=hybrid  # options: local_only, hybrid, cloud_only

# Cloud Provider API Keys (Leave blank if using local only)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Model Endpoints
OLLAMA_BASE_URL=http://localhost:11434

# Security & Storage
APP_DB_PATH=./data/app.db
SECRET_KEY=change_this_to_a_secure_random_key_in_production
